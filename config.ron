(
    // Размер одного тайла в пикселях.
    // Влияет на масштаб поля и на "сетку", по которой ездят танки.
    tile_size: 32.0,

    // Размер игрового поля в тайлах.
    // 13x13 — классика Battle City.
    grid_width: 13,
    grid_height: 13,

    // Скорость танка в пикселях в секунду.
    // 120.0 — комфортно для взрослого. Для ребёнка можно снизить до 80-90.
    tank_speed: 120.0,

    // Скорость снаряда в пикселях в секунду.
    // В классике снаряд примерно в 2-3 раза быстрее танка.
    bullet_speed: 300.0,

    // Размер снаряда в пикселях (квадрат).
    bullet_size: 6.0,

    // Привязки клавиш для игрока 1.
    player1_keys: (
        up:    "W",
        down:  "S",
        left:  "A",
        right: "D",
        fire:  "Space",
    ),
)