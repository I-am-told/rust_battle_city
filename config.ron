(
    // Размер одного тайла в пикселях — внутреннее разрешение отрисовки.
    // Танк занимает 2x2 тайла. На геймплей не влияет (скорости ниже — в тайлах).
    tile_size: 32.0,

    // Масштаб окна при запуске. Окно = поле + рамка с панелью справа.
    // При 26x26 и tile_size 32: 1.0 → 1024x896, 0.75 → 768x672.
    // Окно можно тянуть мышью — пропорции сохраняются.
    window_scale: 1.0,

    // Размер игрового поля в тайлах (тайл = половина танка).
    // 26x26 — как в оригинале Battle City (13x13 блоков по 2x2 тайла).
    grid_width: 26,
    grid_height: 26,

    // Скорость танка игрока, тайлов в секунду.
    // В оригинале ≈ 5.5. 4.0 — чуть спокойнее. Для ребёнка можно 3.0.
    tank_speed: 4.0,

    // Скорость снаряда, тайлов в секунду.
    // В классике снаряд примерно в 2-3 раза быстрее танка.
    bullet_speed: 10.0,

    // Размер снаряда, в тайлах (квадрат).
    bullet_size: 0.2,

    // Помощь при повороте (чтобы легче «попадать» в проезды):
    //   "off"    — как в оригинале: только выравнивание до ближайшего тайла;
    //   "jump"   — если в новую сторону не проехать, а через тайл впереди можно,
    //              танк мгновенно переносится туда и поворачивает;
    //   "smooth" — то же, что "jump", но танк доезжает туда плавно (~0.1 с).
    turn_assist: "smooth",

    // Громкость звука 0.0..1.0. 0.0 — звук выключен.
    sound_volume: 0.6,

    // Гул мотора, пока танк игрока едет. false — без гула.
    engine_sound: true,

    // Игровой процесс. Любую строку можно удалить — будет значение по умолчанию.
    // Время — в секундах.
    gameplay: (
        // Запасных жизней на старте — на каждого игрока (запас общий).
        start_lives_per_player: 2,
        // Пауза между гибелью и звёздочкой возрождения.
        respawn_delay: 1.0,
        // Сколько горит звёздочка перед появлением танка.
        spawn_star_time: 1.0,
        // Защитное поле после появления игрока.
        spawn_shield: 3.0,
        // Защитное поле от бонуса-каски.
        helmet_shield: 10.0,
        // Сколько стоят враги после бонуса-часов.
        freeze_time: 10.0,
        // Сколько держится сталь вокруг штаба после бонуса-лопаты.
        shovel_time: 10.0,
        // Сколько бонус лежит на поле.
        bonus_lifetime: 15.0,
        // Сколько игра идёт после гибели последнего врага.
        victory_delay: 5.0,
        // За сколько танк доезжает до поворота (turn_assist "smooth").
        turn_slide_time: 0.1,
        // Сколько тайлов танк скользит по льду, если отпустить кнопку.
        ice_slide_tiles: 1.0,
        // Во сколько раз быстрее танк игрока на 4-м ранге.
        rank4_speed_mult: 1.3,
        // Скорость любого танка на песке (0.5 — вдвое медленнее).
        sand_speed_mult: 0.5,
        // Короткий щит после того, как броня (ранг 5) приняла попадание.
        armor_hit_shield: 1.0,
        // Перезарядка телепорта-защитника (ранг 6), секунд.
        guardian_cooldown: 5.0,
        // Бонус «мама» (лёгкий режим): сколько секунд действует,
        // как часто обезьянка выпускает облачко и как быстро оно летит (тайлов/с).
        mama_time: 10.0,
        monkey_fire_interval: 0.6,
        cloud_speed: 7.0,
        // Обезьянка летает вокруг сына (P2; в игре на одного — вокруг P1):
        // радиус круга в размерах танка и скорость, оборотов в секунду.
        monkey_orbit_radius: 1.0,
        monkey_orbit_speed: 0.35,
        // Со второго круга карт враги умнее: едут к игрокам и штабу и
        // разворачиваются, чтобы выстрелить. Это шанс такого «умного» решения:
        // 0 — как раньше (случайно), 1 — всегда к цели. 0.6 — «не сильно умные».
        smart_ai_bias: 0.6,
        // Скорость врагов относительно tank_speed. Для ребёнка можно 0.5.
        enemy_speed_mult: 0.75,
        // Скорость вражеских пуль относительно bullet_speed.
        enemy_bullet_speed_mult: 0.75,
        // Каждые столько очков — дополнительная жизнь.
        extra_life_every: 20000,
        // Очки за подобранный бонус.
        bonus_points: 500,
    ),

    // Привязки клавиш для игрока 1.
    // На действие можно задать одну клавишу ("W") или список (["W", "Up"]).
    // Регистр не важен. Доступные имена:
    //   буквы A..Z, цифры 0..9, стрелки Up/Down/Left/Right, F1..F12,
    //   Space, Enter, Tab, Backspace, Escape, Insert, Delete, Home, End,
    //   PageUp, PageDown, CapsLock,
    //   цифровой блок Num0..Num9, NumEnter, NumPlus, NumMinus,
    //   NumMultiply, NumDivide, NumDot,
    //   LShift, RShift, LCtrl, RCtrl, LAlt, RAlt,
    //   Minus, Equal, LeftBracket, RightBracket, Semicolon, Apostrophe,
    //   Comma, Period, Slash, Backslash, Grave.
    // Если зажаты два направления — танк едет по последнему нажатому.
    player1_keys: (
        up:    ["W"],
        down:  ["S"],
        left:  ["A"],
        right: ["D"],
        fire:  ["LCtrl"],
    ),

    // Привязки клавиш для игрока 2 (те же правила).
    player2_keys: (
        up:    ["Up"],
        down:  ["Down"],
        left:  ["Left"],
        right: ["Right"],
        fire:  ["Space"],
    ),

    // Клавиши можно переназначить и в игре: меню → CONTROLS.
    // Они сохраняются в keys.ron рядом с этим файлом и главнее, чем здесь.
    // Чтобы вернуть клавиши отсюда — удалите keys.ron или нажмите RESET в меню.

    // Общие клавиши.
    system_keys: (
        // Пауза во время игры, следующий уровень, новая игра (как Start на Dandy).
        start: ["Enter", "P"],
        // Выход: короткое нажатие ставит паузу, удержание — выходит.
        quit: ["Escape"],
        // Сколько секунд держать клавишу выхода. 0 — выход сразу.
        quit_hold_seconds: 2.0,
    ),

    // Любой параметр можно удалить из файла — будет взято значение по умолчанию.
)
